# Googleログインを有効にするための設定テンプレート。
# このファイルを .streamlit/secrets.toml としてコピーし、
# 下記の値をGoogle Cloud ConsoleのOAuthクライアント情報で置き換えてください。
# （.streamlit/secrets.toml はGit管理対象外です。実際の値は絶対にコミットしないでください）
#
# 手順:
# 1. https://console.cloud.google.com/apis/credentials で「OAuth クライアント ID」を作成
#    - アプリケーションの種類: ウェブ アプリケーション
#    - 承認済みのリダイレクト URI: redirect_uri と同じ値を登録
# 2. cookie_secret はランダムな文字列を生成して設定
#    （例: python -c "import secrets; print(secrets.token_hex(32))"）

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "CHANGE_ME_TO_A_RANDOM_SECRET"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
